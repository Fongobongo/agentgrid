# Multi-stage build for the agentgrid node daemon + mock adapter.
# Stage 5.3 packaging. Bundled SQLite + rustls; no system OpenSSL/SQLite.
# Runtime needs git + sh (bash) for worktree prep and validation commands.
# Hardening P2 item 31: base images pinned by digest (immutable).
FROM rust:1-bookworm@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa AS builder
WORKDIR /src
COPY . .
# Hardening P2 item 31: BuildKit cache mount keeps cargo registry + target
# across rebuilds.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --bins -p agentgrid-node-daemon -p agentgrid-adapters \
    && mkdir -p /out \
    && cp target/release/agentgrid-node-daemon target/release/adapter-mock \
       target/release/adapter-claude target/release/adapter-opencode /out/

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
# Hardening P2 item 31: OCI provenance labels.
LABEL org.opencontainers.image.title="agentgrid-node-daemon" \
      org.opencontainers.image.source="https://github.com/earendil-works/agentgrid" \
      org.opencontainers.image.description="AgentGrid node daemon (worktree + sandbox + event spool)" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git bash curl \
    && rm -rf /var/lib/apt/lists/*
# The agentgrid user runs the daemon (root refused unless AGENTGRID_ALLOW_ROOT=1).
RUN useradd -r -m -d /var/lib/agentgrid agentgrid \
    && mkdir -p /var/lib/agentgrid/workspace /var/lib/agentgrid/repos /var/lib/agentgrid/data \
    && chown -R agentgrid:agentgrid /var/lib/agentgrid
WORKDIR /var/lib/agentgrid
COPY --from=builder /out/agentgrid-node-daemon /usr/local/bin/
COPY --from=builder /out/adapter-mock /usr/local/bin/
COPY --from=builder /out/adapter-claude /usr/local/bin/
COPY --from=builder /out/adapter-opencode /usr/local/bin/
ENV AGENTGRID_DATA_DIR=/var/lib/agentgrid/data \
    AGENTGRID_WORKSPACE_ROOT=/var/lib/agentgrid/workspace \
    AGENTGRID_REPOSITORY_ROOT=/var/lib/agentgrid/repos \
    AGENTGRID_ADAPTERS=mock
# Optional: bake the opencode CLI into the image for a self-contained opencode
# node. Leave OPENCODE_VERSION empty to preserve the operator-provided contract
# (AGENTS.md: no required runtime deps). Usage:
#   docker build --build-arg OPENCODE_VERSION=1.17.16 -f Dockerfile.node-daemon -t ag-node-opencode .
ARG OPENCODE_VERSION=""
RUN if [ -n "$OPENCODE_VERSION" ]; then \
      curl -fsSL "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-linux-x64.tar.gz" -o /tmp/opencode.tar.gz \
      && mkdir -p /tmp/oc \
      && tar -xzf /tmp/opencode.tar.gz -C /tmp/oc \
      && find /tmp/oc -name opencode -type f -exec mv {} /usr/local/bin/opencode \; \
      && chmod +x /usr/local/bin/opencode \
      && rm -rf /tmp/oc /tmp/opencode.tar.gz; \
    fi
USER agentgrid
# Liveness: the daemon touches /var/lib/agentgrid/data/heartbeat.stamp after
# every heartbeat loop iteration (default every 10 s). A wedged loop stops
# touching it and the check fails — restart: unless-stopped then recovers it.
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD test $(( $(date +%s) - $(stat -c %Y /var/lib/agentgrid/data/heartbeat.stamp 2>/dev/null || echo 0) )) -lt 30 || exit 1
ENTRYPOINT ["agentgrid-node-daemon"]
