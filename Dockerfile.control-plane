# Multi-stage build for the agentgrid control plane + CLI + web UI.
# Stage 5.3 packaging. Bundled SQLite + rustls; no system OpenSSL/SQLite.
# Hardening P2 item 31: base images pinned by digest (immutable); Dependabot
# bumps the digest when a new rust/debian bookworm image is published.
# Vite 8 needs Node >=20.19; the rust:1-bookworm apt nodejs is 18. Build
# the web bundle in its own modern-Node stage instead of polluting the Rust
# stage (digest-pinned like the rust base, Hardening P2 item 31).
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS webbuild
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY web/ ./
RUN npm run build

FROM rust:1-bookworm@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa AS builder
WORKDIR /src
COPY . .
# rust-embed packs web/dist into the control-plane binary at compile time;
# the bundle comes from the webbuild stage above (no side files shipped).
COPY --from=webbuild /src/web/dist web/dist
# Build the control plane and CLI binaries (release profile tuned in Cargo.toml).
# Hardening P2 item 31: BuildKit cache mount keeps the registry + incremental
# artifacts across rebuilds so a dependency change does not re-download/re-build
# the world.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --bins -p agentgrid-control-plane -p agentgrid-cli \
    && mkdir -p /out \
    && cp target/release/agentgrid-control-plane target/release/ag /out/

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
# Hardening P2 item 31: OCI provenance labels + a healthcheck.
LABEL org.opencontainers.image.title="agentgrid-control-plane" \
      org.opencontainers.image.source="https://github.com/earendil-works/agentgrid" \
      org.opencontainers.image.description="AgentGrid control plane (Axum + SQLite + rustls)" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*
# Control plane data: SQLite DB and artifacts. The web UI is embedded in
# the binary (rust-embed); set AGENTGRID_WEB_ROOT to serve an override.
RUN useradd -r -m -d /var/lib/agentgrid agentgrid \
    && mkdir -p /var/lib/agentgrid \
    && chown -R agentgrid:agentgrid /var/lib/agentgrid
WORKDIR /var/lib/agentgrid
COPY --from=builder /out/agentgrid-control-plane /usr/local/bin/
COPY --from=builder /out/ag /usr/local/bin/
ENV AGENTGRID_LISTEN=0.0.0.0:7800 \
    AGENTGRID_DB=/var/lib/agentgrid/control-plane.db \
    AGENTGRID_ARTIFACT_ROOT=/var/lib/agentgrid/artifacts
USER agentgrid
EXPOSE 7800
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:7800/health/ready || exit 1
ENTRYPOINT ["agentgrid-control-plane"]
