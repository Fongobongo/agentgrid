# Multi-stage build for the agentgrid control plane + CLI + web UI.
# Stage 5.3 packaging. Bundled SQLite + rustls; no system OpenSSL/SQLite.
# Hardening P2 item 31: base images pinned by digest (immutable); Dependabot
# bumps the digest when a new rust/debian bookworm image is published.
FROM rust:1-bookworm@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa AS builder
# Node is needed only to build the web UI static bundle.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
# Build the control plane and CLI binaries (release profile tuned in Cargo.toml).
# Hardening P2 item 31: BuildKit cache mount keeps the registry + incremental
# artifacts across rebuilds so a dependency change does not re-download/re-build
# the world.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --bins -p agentgrid-control-plane -p agentgrid-cli
# Build the web UI static bundle.
RUN --mount=type=cache,target=/src/web/node_modules \
    cd web && npm ci && npm run build

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
# Hardening P2 item 31: OCI provenance labels + a healthcheck.
LABEL org.opencontainers.image.title="agentgrid-control-plane" \
      org.opencontainers.image.source="https://github.com/earendil-works/agentgrid" \
      org.opencontainers.image.description="AgentGrid control plane (Axum + SQLite + rustls)" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*
# Control plane data: SQLite DB, artifacts, web root.
RUN useradd -r -m -d /var/lib/agentgrid agentgrid \
    && mkdir -p /var/lib/agentgrid /var/lib/agentgrid/web \
    && chown -R agentgrid:agentgrid /var/lib/agentgrid
WORKDIR /var/lib/agentgrid
COPY --from=builder /src/target/release/agentgrid-control-plane /usr/local/bin/
COPY --from=builder /src/target/release/ag /usr/local/bin/
COPY --from=builder /src/web/dist /var/lib/agentgrid/web
ENV AGENTGRID_LISTEN=0.0.0.0:7800 \
    AGENTGRID_DB=/var/lib/agentgrid/control-plane.db \
    AGENTGRID_ARTIFACT_ROOT=/var/lib/agentgrid/artifacts \
    AGENTGRID_WEB_ROOT=/var/lib/agentgrid/web
USER agentgrid
EXPOSE 7800
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:7800/health/ready || exit 1
ENTRYPOINT ["agentgrid-control-plane"]
